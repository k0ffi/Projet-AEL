{
  "watch": [
    "src/serveur.ts",
    "src/routes",
    "src/controllers",
    "src/middlewares",
    "src/config"
  ],
  "ignore": ["src/data/**", "src/tests/**", "node_modules", "dist", "*.json"],
  "ext": "ts",
  "exec": "tsx src/serveur.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000
}
